{
  "protocol": "ark",
  "base_url": "https://ark.cn-beijing.volces.com/api/v3",
  "model": "YOUR_MODEL_OR_ENDPOINT_ID",
  "api_key_env": "VIDEO_API_KEY",
  "auth_header": "Authorization",
  "auth_prefix": "Bearer ",
  "submit_path": "/contents/generations/tasks",
  "status_path": "/contents/generations/tasks/{task_id}",
  "task_id_field": "id",
  "status_field": "status",
  "video_url_field": "content.video_url",
  "success_statuses": ["succeeded"],
  "failure_statuses": ["failed", "cancelled", "expired"],
  "image_mode": "data_uri",
  "supports_last_frame": true,
  "min_duration_s": 4,
  "max_duration_s": 30,
  "supported_ratios": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "2:3", "3:2"],
  "ratio_aliases": {},
  "poll_interval_s": 5,
  "poll_timeout_s": 1800,
  "request_timeout_s": 60,
  "extra_body": {},
  "media_urls": {}
}
